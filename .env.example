# Copia este archivo como .env y rellénalo con la config de tu app web de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > SDK setup and configuration).
# La API key de Firebase no es secreta, pero restríngela por dominio en Google Cloud Console.
VITE_FB_API_KEY=
# Usa tu dominio de Hosting (p. ej. deposito-comun.web.app) para que el login funcione sin cookies de terceros.
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=
